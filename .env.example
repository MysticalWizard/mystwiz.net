# Keys for the live departure board on Home. All optional: a row without its key reads
# "Not connected".
# Copy to .env for local development; set them as secrets on the host.

# Twitch: create an application at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API v3 key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# osu! OAuth application: https://osu.ppy.sh/home/account/edit (OAuth section)
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# GitHub token (no scopes needed). Optional: pushes work without it; commits this year need it.
GITHUB_TOKEN=

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
