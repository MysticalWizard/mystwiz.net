---
// Canvases for src/scripts/fx.ts: speed lines behind the content, click effects above it.
---

<canvas
  class="streaks"
  data-streaks
  aria-hidden="true"
  transition:persist="streaks"
></canvas>
<canvas class="fx" data-fx aria-hidden="true" transition:persist="fx"></canvas>

<script>
  import '../scripts/fx';
</script>

<style>
  canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .streaks {
    z-index: 0;
  }

  .fx {
    z-index: 99;
  }
</style>
