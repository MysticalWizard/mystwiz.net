---
// The ticket machine: a command palette styled as a ticket vending machine. Opens with "/",
// Ctrl/Cmd+K or the Tickets button. Choosing a station prints a ticket out of the slot, then
// rides there. Rendered per page, so fares are counted from the current station.
import { TRANSFERS } from '../data/lines';
import {
  fare,
  STATIONS,
  station as stationById,
  type StationId,
} from '../data/stations';
import { getStrings } from '../i18n';
import Picto from './Picto.astro';
import StationBadge from './StationBadge.astro';

interface Props {
  station?: StationId;
}

const { station } = Astro.props;
const t = getStrings(Astro.currentLocale);
const s = t.tickets;
const here = station ? stationById(station) : undefined;
const fromCode = here ? `MZ${here.no} ${t.stations[here.id].short}` : 'MZ ??';
/** Off the line (404), every ride costs the one-stop fare. */
const fareTo = (id: StationId) => (station ? fare(station, id) : 140);
---

<dialog
  class="tm"
  aria-labelledby="tm-title"
  data-ticket-machine
  data-overlay
  data-from={fromCode}
  data-ticket-head={s.ticket.head('{no}')}
  data-ticket-valid={s.ticket.valid}
>
  <div class="tm-top">
    <div class="tm-led">
      <span id="tm-title">{s.title}</span>
      <small>{s.from(fromCode)}</small>
    </div>
    <button type="button" class="tm-close" data-close>
      {s.close}
      <span class="sr-only">, {s.closeLabel}</span>
    </button>
  </div>

  <div class="tm-grid" role="group" aria-label={s.stations}>
    {STATIONS.map((st) => {
      const name = t.stations[st.id].short;
      const code = `MZ${st.no} ${name}`;
      return st.id === here?.id ? (
        <button
          type="button"
          class="fare"
          aria-disabled="true"
          data-fare={st.id}
        >
          <span class="fr">
            <StationBadge no={st.no} size="36px" />
            <span class="label">{s.here}</span>
          </span>
          <b>{name}</b>
        </button>
      ) : (
        <button
          type="button"
          class="fare"
          data-fare={st.id}
          data-href={st.href}
          data-code={code}
          data-yen={fareTo(st.id)}
        >
          <span class="fr">
            <StationBadge no={st.no} size="36px" />
            <span class="yen">¥{fareTo(st.id)}</span>
          </span>
          <b>{name}</b>
        </button>
      );
    })}
  </div>

  <span class="label">{s.transfers}</span>
  <div class="tm-grid tm-xfers">
    {TRANSFERS.map((line) => (
      <a
        class="fare"
        href={line.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="fr">
          <Picto name={line.picto} />
          <span class="label">{s.line(line.code)}</span>
        </span>
        <b>{line.name}</b>
      </a>
    ))}
  </div>

  <div class="tm-slot" aria-hidden="true">
    <div class="ticket" data-ticket></div>
  </div>
  <div class="tm-gap"></div>
</dialog>

<script>
  import '../scripts/tickets';
</script>

<style>
  .tm {
    width: min(760px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 18px;
    overflow: auto;
    border: 1px solid var(--rule-2);
    border-radius: 14px;
    background: var(--panel);
    box-shadow: var(--shadow);
    color: var(--fg);
  }

  .tm[open] {
    display: grid;
    gap: 16px;
  }

  .tm::backdrop {
    background: rgb(0 0 0 / 0.6);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  .tm-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: stretch;
    gap: 12px;
  }

  /* The machine's LED display. */
  .tm-led {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid #26261f;
    border-radius: 10px;
    background: var(--led-bg);
    box-shadow:
      inset 0 0 0 4px #000,
      inset 0 0 60px rgb(0 0 0 / 0.9);
    color: var(--led-ink);
    font-family: var(--f-led);
    font-size: 24px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .tm-led small {
    font-family: var(--f-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    opacity: 0.7;
  }

  .tm-close {
    padding: 0 14px;
    border: 1px solid var(--rule-2);
    border-radius: 8px;
    background: var(--panel-2);
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .tm-close:hover {
    border-color: var(--fg);
  }

  .tm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }

  .tm-xfers {
    grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
  }

  .fare {
    display: grid;
    gap: 8px;
    padding: 14px;
    border: 1px solid var(--rule-2);
    border-radius: 10px;
    background: var(--panel-2);
    box-shadow: inset 0 -4px 0 var(--rule);
    text-align: left;
    text-decoration: none;
  }

  .fare:hover,
  .fare:focus-visible {
    border-color: var(--line);
  }

  .fare[aria-disabled='true'] {
    cursor: default;
    opacity: 0.55;
  }

  .fr {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .fare > b {
    font-size: 19px;
    font-stretch: 112%;
    font-weight: 760;
    line-height: 1.1;
  }

  .yen {
    color: var(--line-ink);
    font-family: var(--f-led);
    font-size: 26px;
    font-weight: 800;
  }

  .fare :global(.picto) {
    width: 22px;
    height: 22px;
  }

  .tm-slot {
    position: relative;
    height: 16px;
    border-radius: 8px;
    background: #050505;
  }

  /* The printed ticket slides out of the slot. */
  .ticket {
    position: absolute;
    top: 6px;
    left: 50%;
    width: min(360px, 90%);
    padding: 12px 16px;
    border-left: 2px dashed #b8ad8c;
    border-radius: 4px;
    background: #efe6c8;
    box-shadow: 0 18px 30px -16px rgb(0 0 0 / 0.7);
    color: #1a1710;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0;
    transform: translate(-50%, -30px) scaleY(0.2);
    transform-origin: top;
    transition:
      transform 0.55s var(--brake),
      opacity 0.2s;
  }

  .ticket:global(.out) {
    opacity: 1;
    transform: translate(-50%, 0) scaleY(1);
  }

  .ticket :global(b) {
    display: block;
    font-family: var(--f-sign);
    font-size: 20px;
    font-stretch: 110%;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: none;
  }

  .tm-gap {
    height: 70px;
  }
</style>
