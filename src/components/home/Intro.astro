---
// Intro statement with inline sign chips: "Developer first. I build [WEB apps], ..."
import { getStrings } from '../../i18n';

const t = getStrings(Astro.currentLocale);
---

<section class="pt-[clamp(24px,4vw,48px)] pb-sec">
  <p class="intro rise" style="--i: 0">
    {t.home.intro.map((part) =>
      typeof part === 'string' ? (
        part
      ) : 'chip' in part ? (
        <span class="whitespace-nowrap">
          <span class="chip">
            <small>{part.chip}</small> {part.text}
          </span>
          {part.after}
        </span>
      ) : (
        <span class="soft">{part.soft}</span>
      ),
    )}
  </p>
</section>

<style>
  .intro {
    max-width: 1100px;
    font-size: clamp(26px, 3.6vw, 50px);
    font-weight: 560;
    font-stretch: 96%;
    line-height: 1.18;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.28em;
    margin-inline: 0.05em;
    padding: 0.02em 0.3em 0.06em;
    border: 2px solid var(--fg);
    border-radius: 0.18em;
    font-weight: 760;
    font-stretch: 118%;
    line-height: 1;
    vertical-align: 0.04em;
  }

  .chip small {
    font-family: var(--f-mono);
    font-size: 0.34em;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--line-ink);
  }

  .soft {
    color: var(--muted);
  }
</style>
