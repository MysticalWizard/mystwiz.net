---
// LED departure board: one row per line, each alternating between two states every 4.2s.
// Always dark, even in day service. Not an aria-live region (the flips would be noisy):
// each row's accessible name carries both states instead.
//
// Rendered with the board's current data (src/lib/live), then kept fresh in the browser
// with whatever src/scripts/live.ts hears from the board endpoint.
import { BOARD_LINES } from '../../data/lines';
import { getStrings } from '../../i18n';
import { fill, formatAge, formatBoard } from '../../lib/board';
import { getBoardSnapshot } from '../../lib/live';
import Picto from '../Picto.astro';
import SectionHeading from '../SectionHeading.astro';

const t = getStrings(Astro.currentLocale);
const s = t.departures;
const snapshot = await getBoardSnapshot(!Astro.isPrerendered);
const at = new Date(snapshot.generatedAt);
const rows = formatBoard(snapshot.data, at, s);
const footer =
  snapshot.mode === 'live'
    ? s.footer.live
    : snapshot.mode === 'sample'
      ? s.footer.sample
      : fill(s.footer.snapshot, {
          age: formatAge(snapshot.generatedAt, at, s.ago),
        });
---

<section class="rise" style="--i: 2" aria-labelledby="departures-heading">
  <SectionHeading id="departures-heading" label={s.label}>
    {s.heading}
  </SectionHeading>
  <mz-departures
    class="led"
    data-snapshot={JSON.stringify(snapshot)}
    data-strings={JSON.stringify(s)}
  >
    <div class="led-head">
      <span>{s.title}</span>
      <span class="grow"></span>
      <span class="sample" hidden={snapshot.mode !== 'sample'} data-sample>
        {s.sample}
      </span>
      <span class="clock" data-clock aria-hidden="true">
        --<i>:</i>--
      </span>
    </div>
    <div class="led-cols" aria-hidden="true">
      <span>{s.columns.line}</span>
      <span>{s.columns.destination}</span>
      <span>{s.columns.now}</span>
      <span></span>
    </div>
    <ul>
      {BOARD_LINES.map((line) => {
        const row = rows[line.id];
        return (
          <li data-row-item={line.id}>
            <a
              class:list={['led-row', { 'is-live': row.live }]}
              href={line.href}
              target={line.internal ? undefined : '_blank'}
              rel={line.internal ? undefined : 'noopener noreferrer'}
              data-row={line.id}
              data-states={JSON.stringify(row.states)}
            >
              <span class="lr-line">
                <Picto name={line.picto} />
                <span>{line.code}</span>
              </span>{' '}
              <span class="lr-dest">{line.name}</span>{' '}
              <span class="lr-now" aria-hidden="true">
                <span class="lr-txt" data-now>
                  {row.live && <i class="blip" />}
                  {row.states[0]}
                </span>
              </span>
              <span class="sr-only" data-both>
                {row.states.join(', ')}
              </span>
              <span class="came-from" data-from>
                {t.arrivals.cameFrom}
              </span>
              <Picto name={line.internal ? 'arrow' : 'external'} class="go" />
            </a>
          </li>
        );
      })}
    </ul>
    <div class="led-foot">
      <span data-footer>{footer}</span>
      <span>{s.footer.tap}</span>
    </div>
  </mz-departures>
</section>

<script>
  import type { Strings } from '../../i18n';
  import {
    fill,
    formatAge,
    formatBoard,
    type BoardLineId,
  } from '../../lib/board';
  import type { BoardSnapshot } from '../../lib/live/snapshot';
  import { latestBoard } from '../../scripts/live';

  const FLIP_MS = 4200;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const pad = (n: number) => String(n).padStart(2, '0');

  class MzDepartures extends HTMLElement {
    #phase = 0;
    #timers: number[] = [];
    #snapshot?: BoardSnapshot;
    #strings?: Strings['departures'];
    #onBoard = (event: CustomEvent<BoardSnapshot>) => this.show(event.detail);

    connectedCallback() {
      this.#strings = JSON.parse(this.dataset.strings ?? 'null') ?? undefined;
      const embedded = JSON.parse(this.dataset.snapshot ?? 'null') as
        BoardSnapshot | undefined;
      const latest = latestBoard();
      this.show(
        latest && embedded && latest.generatedAt > embedded.generatedAt
          ? latest
          : (embedded ?? latest),
      );
      document.addEventListener('mz:board', this.#onBoard);
      this.tick();
      this.#timers.push(
        window.setInterval(() => this.tick(), 15_000),
        window.setInterval(() => this.flip(), FLIP_MS),
      );
    }

    disconnectedCallback() {
      document.removeEventListener('mz:board', this.#onBoard);
      this.#timers.forEach(clearInterval);
      this.#timers = [];
    }

    /** Writes the rows for a snapshot; ages are counted from now. */
    show(snapshot: BoardSnapshot | undefined) {
      const s = this.#strings;
      if (!snapshot || !s) return;
      this.#snapshot = snapshot;
      const now = new Date();
      const rows = formatBoard(snapshot.data, now, s);
      for (const el of this.querySelectorAll<HTMLElement>('[data-row]')) {
        const row = rows[el.dataset.row as BoardLineId];
        if (!row) continue;
        el.dataset.states = JSON.stringify(row.states);
        el.classList.toggle('is-live', row.live);
        this.write(el, row.states[this.#phase]);
        const both = el.querySelector('[data-both]');
        if (both) both.textContent = row.states.join(', ');
      }
      const sample = this.querySelector<HTMLElement>('[data-sample]');
      if (sample) sample.hidden = snapshot.mode !== 'sample';
      const footer = this.querySelector('[data-footer]');
      if (footer) {
        footer.textContent =
          snapshot.mode === 'live'
            ? s.footer.live
            : snapshot.mode === 'sample'
              ? s.footer.sample
              : fill(s.footer.snapshot, {
                  age: formatAge(snapshot.generatedAt, now, s.ago),
                });
      }
    }

    write(row: HTMLElement, text: string) {
      const now = row.querySelector('[data-now]');
      if (!now) return;
      const children: (Node | string)[] = [text];
      if (row.classList.contains('is-live')) {
        const dot = document.createElement('i');
        dot.className = 'blip';
        children.unshift(dot);
      }
      now.replaceChildren(...children);
    }

    /** The clock shows the visitor's local time; ages on the rows move on with it. */
    tick() {
      const clock = this.querySelector('[data-clock]');
      if (clock) {
        const now = new Date();
        const colon = document.createElement('i');
        colon.textContent = ':';
        clock.replaceChildren(
          pad(now.getHours()),
          colon,
          pad(now.getMinutes()),
        );
      }
      this.show(this.#snapshot);
    }

    /** Every row switches to its other state with a stepped wipe. */
    flip() {
      this.#phase ^= 1;
      for (const row of this.querySelectorAll<HTMLElement>('[data-row]')) {
        const states = JSON.parse(row.dataset.states ?? '[]') as string[];
        const now = row.querySelector<HTMLElement>('[data-now]');
        if (!now || states.length < 2) continue;
        this.write(row, states[this.#phase]);
        if (!reducedMotion.matches) {
          now.classList.remove('flip');
          void now.offsetWidth;
          now.classList.add('flip');
        }
      }
    }
  }

  customElements.define('mz-departures', MzDepartures);
</script>

<style>
  .led {
    position: relative;
    display: block;
    overflow: hidden;
    padding: 16px 18px 8px;
    border: 1px solid #26261f;
    border-radius: 10px;
    background: var(--led-bg);
    box-shadow:
      inset 0 0 0 4px #000,
      inset 0 0 60px rgb(0 0 0 / 0.9),
      var(--shadow);
    color: var(--led-ink);
    font-family: var(--f-led);
    font-weight: 800;
  }

  /* Faint dot mesh over the panel. */
  .led::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
        circle at 2px 2px,
        rgb(255 255 255 / 0.045) 1px,
        transparent 1.6px
      )
      0 0 / 4px 4px;
  }

  .led-head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 4px 12px;
    font-size: 22px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .grow {
    flex: 1;
  }

  .sample {
    padding: 3px 7px;
    border: 1px solid currentColor;
    border-radius: 3px;
    font-family: var(--f-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    opacity: 0.7;
  }

  .clock {
    font-size: 26px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .clock :global(i) {
    font-style: normal;
    animation: blip 1s steps(2, jump-none) infinite;
  }

  ul {
    display: grid;
  }

  .led-cols,
  .led-row {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr) minmax(0, 1.35fr) 18px;
    align-items: center;
    gap: 14px;
  }

  .led-cols {
    padding: 6px 4px;
    border-top: 1px solid #23231d;
    font-family: var(--f-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .led-row {
    position: relative;
    padding: 11px 4px;
    border-top: 1px dashed #23231d;
    font-size: 21px;
    line-height: 1.1;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      color 0.15s,
      text-shadow 0.15s;
  }

  .led-row:hover,
  .led-row:focus-visible {
    color: var(--lit);
    text-shadow: 0 0 10px rgb(var(--lit-rgb) / 0.55);
  }

  .lr-line {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lr-line :global(.picto) {
    width: 20px;
    height: 20px;
  }

  .lr-dest,
  .lr-now {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .lr-txt {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }

  .lr-txt:global(.flip) {
    animation: wipe 0.55s steps(10) both;
  }

  @keyframes wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0);
    }
  }

  .led-row :global(.go) {
    width: 14px;
    height: 14px;
    opacity: 0.6;
  }

  /* Live rows switch to the lit color. */
  .led-row.is-live .lr-now {
    color: var(--lit);
    text-shadow: 0 0 12px rgb(var(--lit-rgb) / 0.75);
  }

  /* For visitors who arrived from this line's bio link (src/data/arrivals.ts). */
  .came-from {
    position: absolute;
    top: -1px;
    right: 30px;
    display: none;
    padding: 1px 6px;
    border-radius: 2px;
    background: var(--led-ink);
    color: var(--led-bg);
    font-family: var(--f-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: translateY(-50%);
  }

  .led-foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 4px 6px;
    border-top: 1px solid #23231d;
    font-family: var(--f-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  @media (max-width: 620px) {
    .led {
      padding: 12px 10px 6px;
    }

    .led-head {
      gap: 8px;
      font-size: 16px;
    }

    .clock {
      font-size: 18px;
    }

    .led-cols,
    .led-row {
      grid-template-columns: 28px minmax(0, 0.9fr) minmax(0, 1.3fr) 12px;
      gap: 8px;
    }

    .lr-line span {
      display: none;
    }

    .led-row {
      padding: 10px 2px;
      font-size: 14px;
      letter-spacing: 0.02em;
    }
  }
</style>
