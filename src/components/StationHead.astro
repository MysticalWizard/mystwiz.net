---
// Board for every station except Home: the station board with a huge outlined ghost of the
// station number peeking out below it. Without an id it is the board of a station that isn't
// on the line (404).
import { station as stationById, type StationId } from '../data/stations';
import StationBoard from './StationBoard.astro';

interface Props {
  id?: StationId;
  sub?: string[];
  title?: string;
}

const { id, sub, title } = Astro.props;
---

<div class="wrap">
  <div class="st-head">
    <div class="ghost" aria-hidden="true" data-plane="ghost">
      {id ? stationById(id).no : '??'}
    </div>
    <div data-plane="shake">
      <StationBoard id={id} sub={sub} title={title} />
    </div>
  </div>
</div>

<script>
  import '../scripts/parallax';
</script>

<style>
  .st-head {
    position: relative;
    isolation: isolate;
    padding-top: clamp(22px, 4vw, 48px);
  }

  .ghost {
    position: absolute;
    right: var(--gutter);
    bottom: -0.56em;
    z-index: -1;
    font-size: clamp(150px, 26vw, 420px);
    font-weight: 900;
    font-stretch: 62%;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px var(--rule-2);
    pointer-events: none;
    user-select: none;
    will-change: transform;
  }
</style>
