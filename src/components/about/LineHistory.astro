---
// How the line got here: a vertical route with a station per milestone. The rename is a
// dashed notice; the current build is the lit "You are here" stop.
import { getStrings } from '../../i18n';

const t = getStrings(Astro.currentLocale);
const stops = t.about.history.stops;
---

<ol class="history rise" style="--i: 2">
  {stops.map((stop) => (
    <li class:list={[stop.kind]}>
      <span class="h-when">{stop.when}</span>
      <span class="h-dot" aria-hidden="true" />
      <div class="h-body">
        <b>{stop.name}</b> <p>{stop.text}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .history {
    display: grid;
    max-width: 900px;
  }

  li {
    position: relative;
    display: grid;
    grid-template-columns: 120px 40px minmax(0, 1fr);
    gap: 0 14px;
    padding-bottom: 28px;
  }

  /* The line between stops. */
  li::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: -8px;
    left: calc(120px + 14px + 17px);
    width: 6px;
    background: var(--line);
  }

  li:last-child::before {
    display: none;
  }

  .h-when {
    padding-top: 6px;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-align: right;
    text-transform: uppercase;
    color: var(--muted);
  }

  .h-dot {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
  }

  .h-dot::before {
    content: '';
    width: 22px;
    height: 22px;
    border: 4px solid var(--fg);
    border-radius: 50%;
    background: var(--panel);
  }

  .h-body b {
    display: block;
    padding-top: 4px;
    font-size: 22px;
    font-stretch: 112%;
    font-weight: 760;
    line-height: 1.2;
  }

  .h-body p {
    color: var(--muted);
  }

  .renamed .h-body {
    padding: 10px 14px;
    border: 1px dashed var(--line);
    border-radius: 6px;
    background: var(--panel-2);
  }

  .renamed .h-body b {
    font-size: 18px;
  }

  .here .h-dot::before {
    border-color: var(--lit);
    background: var(--lit);
    box-shadow: 0 0 16px rgb(var(--lit-rgb) / 0.7);
  }

  @media (max-width: 860px) {
    li {
      grid-template-columns: 40px minmax(0, 1fr);
    }

    li::before {
      left: 17px;
    }

    .h-when {
      order: 2;
      grid-column: 2;
      padding: 0;
      text-align: left;
    }

    .h-dot {
      grid-row: 1 / 3;
    }
  }
</style>
