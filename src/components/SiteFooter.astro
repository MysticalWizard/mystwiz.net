---
import { TRANSFERS } from '../data/lines';
import { getStrings } from '../i18n';
import Picto from './Picto.astro';
import StationBadge from './StationBadge.astro';

const t = getStrings(Astro.currentLocale);
---

<footer class="foot">
  <div class="wrap">
    <div class="blogline">
      <span class="hazard" aria-hidden="true"></span>
      <StationBadge no="B" size="46px" minor />
      <div>
        <b>{t.footer.blog.name}</b>
        <span class="host">{t.footer.blog.host}</span>
      </div>
      <span class="note label">{t.footer.blog.note}</span>
    </div>

    <div class="foot-row">
      <ul class="xfers" aria-label={t.footer.transfers}>
        {TRANSFERS.map((line) => (
          <li>
            <a
              class="xfer"
              href={line.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Picto name={line.picto} />
              {line.name}
            </a>
          </li>
        ))}
      </ul>
      <p class="fine">{t.footer.fine(new Date().getFullYear())}</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--rule);
    background: var(--bg-2);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  .blogline {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding-block: 22px;
    border-bottom: 1px solid var(--rule);
  }

  .hazard {
    width: 56px;
    height: 40px;
    border-radius: 4px;
    background: repeating-linear-gradient(
      -45deg,
      var(--line) 0 8px,
      var(--bg) 8px 16px
    );
  }

  .blogline b {
    display: block;
    font-size: 22px;
    font-weight: 780;
    font-stretch: 116%;
    line-height: 1.1;
  }

  .host {
    font-family: var(--f-mono);
    font-size: 13px;
    color: var(--muted);
  }

  .foot-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    padding-block: 22px;
  }

  .xfers {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .xfer {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border: 1px solid var(--rule-2);
    border-radius: 5px;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .xfer:hover {
    border-color: var(--fg);
  }

  .fine {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  @media (max-width: 620px) {
    .blogline {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .hazard,
    .note {
      display: none;
    }
  }
</style>
