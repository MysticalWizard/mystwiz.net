---
// The site header: the line with its four stops, like the route map above a train's doors.
// It stays on screen across rides (transition:persist), so its script keeps it in sync.
import { TRANSFERS } from '../data/lines';
import { STATIONS, stationIndex, type StationId } from '../data/stations';
import { getStrings } from '../i18n';
import Picto from './Picto.astro';
import StationBadge from './StationBadge.astro';

interface Props {
  /** Current station; undefined when off the line (404). */
  station?: StationId;
}

const { station } = Astro.props;
const t = getStrings(Astro.currentLocale);
const current = station ? stationIndex(station) : -1;
const twitch = TRANSFERS.find((line) => line.id === 'tw')!;
---

<header class="vision" transition:persist="route-bar">
  <div class="vision-in wrap">
    <a class="brand" href="/" data-brand>
      <span aria-hidden="true">
        <StationBadge no={current >= 0 ? STATIONS[current].no : '??'} />
      </span>
      <span class="brand-word">mystwiz</span>
      <span class="sr-only">{t.routeBar.homeSuffix}</span>
    </a>

    <nav class="route" aria-label={t.routeBar.nav}>
      <span
        class="train-mark"
        style={`--i: ${Math.max(current, 0)}`}
        hidden={current < 0}
        aria-hidden="true"
        data-train-mark
      ></span>
      <ol>
        {STATIONS.map((s, i) => (
          <li>
            <a
              class="stop"
              href={s.href}
              aria-current={i === current ? 'page' : undefined}
              data-stop={s.id}
            >
              <span class="dot" aria-hidden="true" />
              <span class="lbl">
                <em aria-hidden="true">{s.no}</em>
                {t.stations[s.id].short}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="controls">
      <a
        class="live-pill"
        href={twitch.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="blip" aria-hidden="true"></i>
        {t.routeBar.live}
        <span class="sr-only">{t.routeBar.liveLabel}</span>
      </a>
      <button
        class="ctl"
        type="button"
        aria-haspopup="dialog"
        aria-keyshortcuts="/ Control+K Meta+K"
        data-open-tickets
      >
        <Picto name="ticket" />
        <span class="t">{t.routeBar.tickets}</span>
        <kbd aria-hidden="true">/</kbd>
      </button>
      <button
        class="ctl"
        type="button"
        aria-pressed="false"
        data-melody
        data-hint={t.routeBar.melodyHint}
      >
        <Picto name="mute" class="when-off" />
        <Picto name="speaker" class="when-on" />
        <span class="t">
          {t.routeBar.melody.label}{' '}
          <span class="when-off" aria-hidden="true">
            {t.routeBar.melody.off}
          </span>
          <span class="when-on" aria-hidden="true">
            {t.routeBar.melody.on}
          </span>
        </span>
      </button>
      <button class="ctl" type="button" data-service-toggle>
        <Picto name="moon" class="day:hidden" />
        <Picto name="sun" class="hidden day:block" />
        <span class="t">
          <span class="day:hidden">{t.routeBar.service.night}</span>
          <span class="hidden day:inline">{t.routeBar.service.day}</span>
        </span>
        <span class="sr-only">
          <span class="day:hidden">{t.routeBar.service.toDay}</span>
          <span class="hidden day:inline">{t.routeBar.service.toNight}</span>
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  import { STATIONS, stationIndex } from '../data/stations';
  import '../scripts/arrival';
  import '../scripts/live';
  import { currentStation } from '../scripts/ride';
  import { carryService, switchService } from '../scripts/service';
  import { setSound, soundOn } from '../scripts/sound';
  import { toast } from '../scripts/toast';

  const melodyButton = () =>
    document.querySelector<HTMLElement>('[data-melody]');

  melodyButton()?.setAttribute('aria-pressed', String(soundOn()));

  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    if (target.closest('[data-service-toggle]')) {
      void switchService();
      return;
    }
    const melody = target.closest<HTMLElement>('[data-melody]');
    if (melody) {
      const on = !soundOn();
      setSound(on);
      melody.setAttribute('aria-pressed', String(on));
      if (on && melody.dataset.hint) toast(melody.dataset.hint);
    }
  });

  // Each page is rendered in night service; keep the visitor's choice on the next station.
  document.addEventListener('astro:before-swap', (event) =>
    carryService(event.newDocument),
  );

  const trainMark = () =>
    document.querySelector<HTMLElement>('[data-train-mark]');

  // The train slides to the next stop while the doors are closed.
  document.addEventListener('mz:ride', (event) => {
    const mark = trainMark();
    if (mark && event.detail.to) {
      mark.style.setProperty('--i', String(stationIndex(event.detail.to)));
    }
  });

  document.addEventListener('astro:after-swap', () => {
    const here = currentStation();
    const i = here ? stationIndex(here) : -1;
    const mark = trainMark();
    if (mark) {
      mark.hidden = i < 0;
      if (i >= 0) mark.style.setProperty('--i', String(i));
    }
    for (const stop of document.querySelectorAll<HTMLElement>('[data-stop]')) {
      if (stop.dataset.stop === here) stop.setAttribute('aria-current', 'page');
      else stop.removeAttribute('aria-current');
    }
    const badge = document.querySelector('[data-brand] i');
    if (badge) badge.textContent = i >= 0 ? STATIONS[i].no : '??';
  });
</script>

<style>
  .vision {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    padding-top: env(safe-area-inset-top, 0px);
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .vision-in {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 20px;
    height: var(--bar);
    padding-left: max(var(--gutter), env(safe-area-inset-left, 0px));
    padding-right: max(var(--gutter), env(safe-area-inset-right, 0px));
  }

  .brand > span[aria-hidden] {
    display: contents;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    text-decoration: none;
  }

  .brand-word {
    font-size: 21px;
    font-weight: 800;
    font-stretch: 122%;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .route {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 560px;
  }

  .route ol {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: start;
  }

  .route ol::before {
    content: '';
    position: absolute;
    top: 9px;
    left: 12.5%;
    right: 12.5%;
    height: 4px;
    border-radius: 2px;
    background: var(--line);
    box-shadow: 0 0 0 1px var(--rule-2);
  }

  .stop {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 5px;
    min-width: 0;
    text-decoration: none;
  }

  .dot {
    width: 22px;
    height: 22px;
    border: 4px solid var(--line);
    border-radius: 50%;
    background: var(--panel);
    transition: transform 0.3s var(--brake);
  }

  .stop:hover .dot {
    transform: scale(1.18);
  }

  .lbl {
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--muted);
  }

  .lbl em {
    margin-right: 5px;
    font-style: normal;
    color: var(--line-ink);
  }

  .stop[aria-current='page'] .lbl {
    color: var(--fg);
  }

  /* The train sits on the current stop and slides along the line during a ride. */
  .train-mark {
    position: absolute;
    top: 1px;
    left: calc(12.5% + 25% * var(--i, 0));
    width: 38px;
    height: 20px;
    margin-left: -19px;
    border-radius: 10px 10px 6px 6px;
    background: var(--fg);
    box-shadow: 0 0 0 3px var(--bg);
    pointer-events: none;
    transition: left 0.7s var(--brake);
  }

  /* While someone holds to depart, the train follows the hold directly. */
  .train-mark:global(.creep) {
    transition: none;
  }

  .train-mark::before {
    content: '';
    position: absolute;
    top: 4px;
    left: 6px;
    right: 6px;
    height: 6px;
    border-radius: 2px;
    background: repeating-linear-gradient(
      90deg,
      var(--bg) 0 7px,
      transparent 7px 10px
    );
  }

  .train-mark::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--line);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Only while the Twitch line is live (data-on-air on <html>): neon, linking to the stream. */
  .live-pill {
    display: none;
    align-items: center;
    gap: 7px;
    height: 26px;
    padding: 0 10px;
    border-radius: 13px;
    background: var(--lit);
    box-shadow: 0 0 18px rgb(var(--lit-rgb) / 0.55);
    color: #0b0b0a;
    font-family: var(--f-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }

  :global(:root[data-on-air]) .live-pill {
    display: inline-flex;
  }

  .ctl {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 12px;
    border: 1px solid var(--rule-2);
    border-radius: 6px;
    background: var(--panel);
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ctl:hover {
    border-color: var(--fg);
  }

  .ctl[aria-pressed='true'] {
    border-color: var(--line);
    color: var(--line-ink);
  }

  .ctl[aria-pressed='true'] :global(.when-off),
  .ctl[aria-pressed='false'] :global(.when-on) {
    display: none;
  }

  .ctl kbd {
    padding: 0 4px;
    border: 1px solid var(--rule-2);
    border-radius: 3px;
    font-family: var(--f-mono);
    font-size: 10px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .route {
      max-width: 220px;
    }

    /* Labels leave the screen but stay as accessible names. */
    .lbl,
    .t {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .ctl {
      justify-content: center;
      width: 36px;
      padding: 0;
    }

    .ctl kbd {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .vision-in {
      gap: 10px;
    }

    /* Off screen on phones, but still the link's name. */
    .brand-word {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
