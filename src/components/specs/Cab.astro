---
// Peripherals are the driver's cab: three sign panels with inverted headers.
import { CAB } from '../../data/specs';
import Picto from '../Picto.astro';
---

<div class="cab rise" style="--i: 1">
  {CAB.map((group) => (
    <div class="cab-g">
      <h3>
        <Picto name={group.picto} />
        {group.name}
      </h3>
      <dl>
        {group.items.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>
              {item.model} {item.detail && <small>{item.detail}</small>}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  ))}
</div>

<style>
  .cab {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .cab-g {
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--panel);
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: var(--fg);
    color: var(--bg);
    font-size: 15px;
    font-stretch: 118%;
    font-weight: 780;
    letter-spacing: 0.02em;
  }

  dl {
    padding: 6px 16px 12px;
  }

  dl div {
    display: grid;
    gap: 1px;
    padding: 9px 0;
    border-bottom: 1px dashed var(--rule);
  }

  dl div:last-child {
    border-bottom: 0;
  }

  dt {
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  dd {
    font-size: 16px;
    line-height: 1.3;
  }

  dd small {
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .cab {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .cab {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
