---
// "Try the Wooting": two keycaps, Z and X. Tapping them (or Z and X on the keyboard, only while
// on Specs) measures stream speed the way osu! players count it.
import { getStrings } from '../../i18n';

const t = getStrings(Astro.currentLocale);
const s = t.specs.tap;
---

<mz-taptest class="tap rise" style="--i: 2">
  <div class="keys">
    <button class="key" type="button" data-key="z" aria-label={s.key('Z')}>
      Z
    </button>
    <button class="key" type="button" data-key="x" aria-label={s.key('X')}>
      X
    </button>
  </div>
  <div>
    <div class="tap-read">
      <div>
        <b data-read="bpm">000</b>
        <small>{s.bpm}</small>
      </div>
      <div>
        <b data-read="count">000</b>
        <small>{s.taps}</small>
      </div>
      <div>
        <b data-read="best">000</b>
        <small>{s.best}</small>
      </div>
    </div>
    <p>{s.text}</p>
  </div>
</mz-taptest>

<script>
  import { emptyTaps, idleTaps, readout, tapAt } from '../../lib/tap';
  import { tick } from '../../scripts/sound';

  /** A pause this long starts a new run. */
  const IDLE_MS = 1600;
  const KEYS = new Set(['z', 'x']);

  class MzTapTest extends HTMLElement {
    #taps = emptyTaps();
    #idle = 0;

    #keydown = (event: KeyboardEvent) => {
      const key = event.key.toLowerCase();
      if (!KEYS.has(key) || event.repeat) return;
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target as Element;
      if (target.matches('input, textarea, select, [contenteditable]')) return;
      this.tap(key);
    };

    #keyup = (event: KeyboardEvent) => this.lift(event.key.toLowerCase());

    connectedCallback() {
      document.addEventListener('keydown', this.#keydown);
      document.addEventListener('keyup', this.#keyup);
      for (const key of this.querySelectorAll<HTMLElement>('[data-key]')) {
        const name = key.dataset.key ?? '';
        key.addEventListener('pointerdown', (event) => {
          event.preventDefault();
          this.tap(name);
        });
        key.addEventListener('pointerup', () => this.lift(name));
        key.addEventListener('pointerleave', () => this.lift(name));
        // Keyboard activation of the on-screen keys counts as a tap too.
        key.addEventListener('click', (event) => {
          if (event.detail === 0) {
            this.tap(name);
            setTimeout(() => this.lift(name), 90);
          }
        });
      }
    }

    disconnectedCallback() {
      document.removeEventListener('keydown', this.#keydown);
      document.removeEventListener('keyup', this.#keyup);
      clearTimeout(this.#idle);
    }

    tap(key: string) {
      this.querySelector(`[data-key="${key}"]`)?.classList.add('down');
      this.#taps = tapAt(this.#taps, performance.now());
      this.show();
      tick();
      clearTimeout(this.#idle);
      this.#idle = window.setTimeout(() => {
        this.#taps = idleTaps(this.#taps);
        this.show();
      }, IDLE_MS);
    }

    lift(key: string) {
      this.querySelector(`[data-key="${key}"]`)?.classList.remove('down');
    }

    show() {
      const set = (name: string, value: number) => {
        const el = this.querySelector(`[data-read="${name}"]`);
        if (el) el.textContent = readout(value);
      };
      set('bpm', this.#taps.bpm);
      set('count', this.#taps.count);
      set('best', this.#taps.best);
    }
  }

  customElements.define('mz-taptest', MzTapTest);
</script>

<style>
  .tap {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(20px, 4vw, 56px);
    padding: clamp(20px, 3vw, 32px);
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--panel-2);
  }

  .keys {
    display: flex;
    gap: 12px;
  }

  .key {
    width: 92px;
    height: 92px;
    border: 2px solid var(--fg);
    border-radius: 12px;
    background: var(--panel);
    box-shadow: 0 7px 0 var(--fg);
    font-size: 40px;
    font-weight: 800;
    touch-action: manipulation;
    user-select: none;
    transition:
      transform 0.05s,
      box-shadow 0.05s,
      background 0.05s;
  }

  .key:global(.down) {
    background: var(--lit);
    box-shadow: 0 1px 0 var(--fg);
    color: #0b0b0a;
    transform: translateY(6px);
  }

  .tap-read {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 36px;
  }

  .tap-read div {
    display: grid;
  }

  .tap-read b {
    color: var(--line-ink);
    font-family: var(--f-led);
    font-size: clamp(44px, 5vw, 64px);
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    line-height: 1;
  }

  .tap-read small {
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  p {
    margin-top: 10px;
    font-size: 15px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .tap {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 620px) {
    .key {
      width: 76px;
      height: 76px;
    }
  }
</style>
