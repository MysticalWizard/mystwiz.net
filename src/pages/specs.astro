---
import SectionHeading from '../components/SectionHeading.astro';
import Cab from '../components/specs/Cab.astro';
import Formation from '../components/specs/Formation.astro';
import TapTest from '../components/specs/TapTest.astro';
import { CARS, INSPECTED, SERIES } from '../data/specs';
import { getStrings } from '../i18n';
import Station from '../layouts/Station.astro';

const t = getStrings(Astro.currentLocale);
const { specs } = t;
---

<Station id="specs" sub={specs.sub(INSPECTED)}>
  <section class="py-sec" aria-labelledby="rolling-heading">
    <SectionHeading id="rolling-heading" label={specs.rolling.label}>
      {specs.rolling.heading(SERIES, CARS.length)}
    </SectionHeading>
    <Formation />
  </section>

  <section class="pb-sec" aria-labelledby="cab-heading">
    <SectionHeading id="cab-heading" label={specs.cab.label}>
      {specs.cab.heading}
    </SectionHeading>
    <Cab />
  </section>

  <section class="pb-sec" aria-labelledby="tap-heading">
    <SectionHeading id="tap-heading" label={specs.tap.label}>
      {specs.tap.heading}
    </SectionHeading>
    <TapTest />
  </section>
</Station>
